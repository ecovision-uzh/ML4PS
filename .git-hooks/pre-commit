#!/usr/bin/env bash
# Pre-commit hook: clear Jupyter notebook outputs before they are committed
# Uses nbconvert through uv if available (in its own cached tool environment, the course .venv is left untouched),
# otherwise the ML4PSenv conda environment, otherwise skips the cleaning.
# To set up the hook on your local repository run: git config core.hooksPath .git-hooks

set -e

# Find staged notebooks
files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ipynb$' || true)

if [ -z "$files" ]; then
    exit 0
fi

if command -v uv &>/dev/null; then
    echo "🧹 Cleaning Jupyter notebook outputs (using uv)..."
    clear_outputs() { uvx --quiet --from nbconvert==7.16.6 jupyter-nbconvert --clear-output --inplace "$1"; }
elif command -v conda &>/dev/null; then
    echo "🧹 Cleaning Jupyter notebook outputs (using ML4PS env)..."
    clear_outputs() { conda run -n ML4PSenv jupyter nbconvert --clear-output --inplace "$1"; }
else
    echo "⚠️  Neither uv nor conda found — skipping notebook cleaning."
    exit 0
fi

while IFS= read -r file; do
    if [ -f "$file" ]; then
        clear_outputs "$file" >/dev/null 2>&1 || \
            echo "⚠️  Failed to clean $file"
        git add "$file"
    fi
done <<< "$files"
